# Allowlist the small, buildless application's runtime and container config.
**
!Dockerfile
!.dockerignore
!index.php
!project.php
!privacy.php
!terms.php
!licenses.php
!legal.php
!assets/
!assets/**
!config/
!config/appConfig.php
!data/
!data/**
!includes/
!includes/**
includes/contactMailer.php
!pages/
!pages/**
!docker/
!docker/start-portfolio.sh
!docker/apache-portfolio.conf
!docker/php-production.ini
!docker/healthcheck.php

# Defense in depth if an allowed directory gains local or sensitive files.
**/.git
**/.env
**/.env.*
**/*secret*
**/*credential*.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.sql
**/*.sqlite*
**/*.log
**/*.bak
**/*.backup
**/*~
**/.DS_Store
**/Thumbs.db
**/node_modules
**/vendor
